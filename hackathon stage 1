import pandas as pd


applications_df = pd.read_csv('data-hackathon-main/applications.csv')
punches_df = pd.read_csv('data-hackathon-main/biometric_punches.csv')


print("--- Applications Missing Values ---")
print(applications_df.isnull().sum())

print("\n--- Biometric Punches Missing Values ---")
print(punches_df.isnull().sum())

for col in ['application_id', 'candidate_id', 'job_req_id', 'dept_id', 'stage']:
    applications_df[col] = applications_df[col].astype(str).str.strip()

for col in ['punch_id', 'device_id']:
    punches_df[col] = punches_df[col].astype(str).str.strip()


applications_df['stage_date'] = pd.to_datetime(applications_df['stage_date'])
punches_df['punch_time'] = pd.to_datetime(punches_df['punch_time'])

print("Data standardization successfully mukammal ho gayi hai!")
print(applications_df.info())
print(punches_df.info())

applications_df.to_csv('cleaned_applications.csv', index=False)
punches_df.to_csv('cleaned_biometric_punches.csv', index=False)

print("Cleaned data successfully save ho gaya hai!")

